# Supabase Configuration (Server-side only)
# Get these values from your Supabase project dashboard: https://app.supabase.com

SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# SMTP Configuration for Contact Form (InMotion Hosting / cPanel)
# Get these from your cPanel Email Accounts settings
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your_email_password
CONTACT_EMAIL=info@yourdomain.com

# Google Slides Embed URLs
VAPA_LINKS_SLIDES_URL=https://docs.google.com/presentation/d/YOUR_PRESENTATION_ID/embed?start=false&loop=false&delayms=3000
VAPA_RESPRO_SLIDES_URL=https://docs.google.com/presentation/d/YOUR_PRESENTATION_ID/embed?start=false&loop=false&delayms=3000
ADMIN_EMAILS=name@domain.com,name2@domain.com

# Unsplash API (for image search in admin)
# Register at https://unsplash.com/developers to get a free access key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Google Gemini API (for AI-powered search query refinement)
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Better Auth Configuration
# BETTER_AUTH_URL: Used for email links and logo images
# Locally: http://localhost:3000 — In production (Vercel): https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_auth_secret

# Database Connection (Better Auth requires direct PostgreSQL access)
# Get from Supabase Dashboard → Settings → Database → Connection string → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Instagram Graph API (for Instagram feed on home page)
# 1. Create a Meta Developer app at https://developers.facebook.com
# 2. Add "Instagram" product and connect your Professional Instagram account
# 3. Generate a short-lived token, then exchange it for a long-lived token (60 days)
# 4. Paste the long-lived token below
# Refresh command: curl -X GET "https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=YOUR_TOKEN"
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_token

# Stripe Webhook Configuration
# Get STRIPE_SECRET_KEY from https://dashboard.stripe.com/test/apikeys
# Get STRIPE_WEBHOOK_SECRET from https://dashboard.stripe.com/test/webhooks (after creating the endpoint)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
NEXT_PUBLIC_STRIPE_BASE_URL=payment_link_url

# Sentry (Error Tracking & Performance Monitoring)
# Create a project at https://sentry.io and get your DSN
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@oXXXXXX.ingest.us.sentry.io/XXXXXXX
# Auth token for source map uploads — get from https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=sntrys_your_auth_token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# PostHog (Analytics, Session Replays, Heatmaps)
# Create a project at https://posthog.com and get your API key
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com